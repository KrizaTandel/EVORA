# EVORA HRMS - Environment Configuration Template
# Copy this file to .env and configure for your local environment (e.g. XAMPP)

APP_NAME="EVORA HRMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/EVORA

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=evora_hrms
DB_USER=root
DB_PASS=

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Timezone
APP_TIMEZONE=Asia/Kolkata
